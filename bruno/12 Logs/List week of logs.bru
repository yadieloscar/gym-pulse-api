meta {
  name: List week of logs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/logs?week=2026-11-16
  body: none
  auth: inherit
}

params:query {
  week: 2026-11-16
}

tests {
  test("not a server error", () => expect(res.status).to.be.below(500));
}

docs {
  `GET /api/v1/logs`
  
  week is the Monday date of the week; required
}
