meta {
  name: DESTRUCTIVE Record next-morning check
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/training-blocks/{{blockId}}/exposures/{{exposureId}}/next-morning
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{operationKey}}
}

body:json {
  {
    "response": "baseline",
    "expected_revision": {{blockRevision}},
    "operation_key": "{{operationKey}}"
  }
}

script:pre-request {
  if (String(bru.getEnvVar("allowDestructive")) !== "true") {
    throw new Error("DESTRUCTIVE request blocked: set allowDestructive to true in this environment to send it");
  }
}

script:post-response {
  // Keep the previous value when this request fails.
  if (res.status < 300) {
    const body = res.getBody();
    try { const v = body.revision; if (v !== undefined && v !== null) bru.setVar("blockRevision", v); } catch (e) {}
  }
}

tests {
  test("not a server error", () => expect(res.status).to.be.below(500));
}

docs {
  `POST /api/v1/training-blocks/{block_id}/exposures/{exposure_id}/next-morning`
  
  Recorded once per exposure; response is baseline or above_baseline
}
