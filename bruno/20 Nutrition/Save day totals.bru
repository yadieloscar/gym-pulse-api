meta {
  name: Save day totals
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/nutrition/days/{{today}}
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{operationKey}}
}

body:json {
  {
    "protein_g": 162.5,
    "energy_kcal": 2150,
    "expected_revision": 0,
    "operation_key": "{{operationKey}}"
  }
}

tests {
  test("not a server error", () => expect(res.status).to.be.below(500));
}

docs {
  `PUT /api/v1/nutrition/days/{date}`
  
  Date not after local today; expected_revision 0 first, then current; empty values clear the day
}
