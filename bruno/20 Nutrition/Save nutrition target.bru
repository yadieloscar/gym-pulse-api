meta {
  name: Save nutrition target
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/nutrition/target
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{operationKey}}
}

body:json {
  {
    "protein_g": 150,
    "energy_kcal": 2200,
    "expected_revision": 0,
    "operation_key": "{{operationKey}}"
  }
}

tests {
  test("not a server error", () => expect(res.status).to.be.below(500));
}

docs {
  `PUT /api/v1/nutrition/target`
  
  expected_revision 0 first, then current
}
