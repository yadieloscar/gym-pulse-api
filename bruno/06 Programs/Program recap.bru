get {
  url: {{baseUrl}}/api/v1/programs/{{programId}}/recap
  body: none
  auth: inherit
}

tests {
  test("not a server error", () => expect(res.status).to.be.below(500));
}

docs {
  `GET /api/v1/programs/{id}/recap` (contract 1.20.0)

  Weeks on target, workouts done, and how the main lifts moved, computed from
  the program's scheduled workouts. Read-only.
}
