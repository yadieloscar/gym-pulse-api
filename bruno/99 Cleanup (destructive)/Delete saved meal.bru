meta {
  name: DESTRUCTIVE Delete saved meal
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/api/v1/nutrition/meals/{{mealId}}?expected_revision={{mealRevision}}
  body: none
  auth: inherit
}

params:query {
  expected_revision: {{mealRevision}}
}

headers {
  Idempotency-Key: {{$randomUUID}}
}

script:pre-request {
  if (String(bru.getEnvVar("allowDestructive")) !== "true") {
    throw new Error("DESTRUCTIVE request blocked: set allowDestructive to true in this environment to send it");
  }
}

tests {
  test("not a server error", () => expect(res.status).to.be.below(500));
}

docs {
  `DELETE /api/v1/nutrition/meals/{id}`
  
  Idempotency-Key header required (no body); 204
}
