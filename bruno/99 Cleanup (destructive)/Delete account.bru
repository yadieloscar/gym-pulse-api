meta {
  name: DESTRUCTIVE Delete account
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}/api/v1/account
  body: none
  auth: inherit
}

script:pre-request {
  if (String(bru.getEnvVar("allowDestructive")) !== "true") {
    throw new Error("DESTRUCTIVE request blocked: set allowDestructive to true in this environment to send it");
  }
}

tests {
  test("not a server error", () => expect(res.status).to.be.below(500));
}

docs {
  `DELETE /api/v1/account`
  
  Wipes every row for the user, irreversible; 10/min; no body; 204
}
