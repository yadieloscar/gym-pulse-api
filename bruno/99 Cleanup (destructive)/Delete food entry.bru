meta {
  name: DESTRUCTIVE Delete food entry
  type: http
  seq: 1
}

delete {
  url: {{baseUrl}}/api/v1/nutrition/entries/{{entryId}}?expected_revision={{entryRevision}}
  body: none
  auth: inherit
}

params:query {
  expected_revision: {{entryRevision}}
}

headers {
  Idempotency-Key: {{$randomUUID}}
}

script:pre-request {
  if (String(bru.getEnvVar("allowDestructive")) !== "true") {
    throw new Error("DESTRUCTIVE request blocked: set allowDestructive to true in this environment to send it");
  }
}

tests {
  test("not a server error", () => expect(res.status).to.be.below(500));
}

docs {
  `DELETE /api/v1/nutrition/entries/{id}`
  
  Idempotency-Key header required (no body); 200 with the updated day
}
