meta {
  name: DESTRUCTIVE Delete past workout
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/v1/scheduled-workouts/{{scheduledWorkoutId}}
  body: none
  auth: inherit
}

script:pre-request {
  if (String(bru.getEnvVar("allowDestructive")) !== "true") {
    throw new Error("DESTRUCTIVE request blocked: set allowDestructive to true in this environment to send it");
  }
}

tests {
  test("not a server error", () => expect(res.status).to.be.below(500));
}

docs {
  `DELETE /api/v1/scheduled-workouts/{id}`
  
  Only past or finalized workouts; deletes sessions and sets too; 204
}
