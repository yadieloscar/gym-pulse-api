meta {
  name: Current user
  type: http
  seq: 3
}

get {
  url: {{supabaseUrl}}/auth/v1/user
  body: none
  auth: bearer
}

headers {
  apikey: {{supabasePublishableKey}}
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  // Needs a Supabase project; skipped when no publishable key is set (for example the local stack).
  if (!bru.getEnvVar("supabasePublishableKey")) {
    bru.runner.skipRequest();
  }
}

tests {
  test("token is valid at Supabase", () => expect(res.status).to.equal(200));
}

docs {
  Shows who the stored token belongs to. The `id` is the value for the API's `ALLOWED_USER_IDS`.
}
