meta {
  name: Update saved meal
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/nutrition/meals/{{mealId}}
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{operationKey}}
}

body:json {
  {
    "name": "Post-workout shake (large)",
    "items": [
      {
        "food": {
          "id": "{{foodId}}"
        },
        "serving": {
          "label": "30 g",
          "grams": 30
        },
        "amount": 0.5
      }
    ],
    "expected_revision": {{mealRevision}},
    "operation_key": "{{operationKey}}"
  }
}

script:post-response {
  // Keep the previous value when this request fails.
  if (res.status < 300) {
    const body = res.getBody();
    try { const v = body.revision; if (v !== undefined && v !== null) bru.setVar("mealRevision", v); } catch (e) {}
  }
}

tests {
  test("not a server error", () => expect(res.status).to.be.below(500));
}

docs {
  `PUT /api/v1/nutrition/meals/{id}`
}
