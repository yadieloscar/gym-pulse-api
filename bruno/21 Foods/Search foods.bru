meta {
  name: Search foods
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/nutrition/foods/search?q=greek yogurt&limit=25
  body: none
  auth: inherit
}

params:query {
  q: greek yogurt
  limit: 25
}

tests {
  test("not a server error", () => expect(res.status).to.be.below(500));
}

docs {
  `GET /api/v1/nutrition/foods/search`
  
  60/min; q must be at least 2 characters
}
