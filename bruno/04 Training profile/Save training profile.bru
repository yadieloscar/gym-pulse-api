meta {
  name: Save training profile
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/v1/training-profile
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{operationKey}}
}

body:json {
  {
    "primary_goal": "strength",
    "available_days": [
      1,
      3,
      5
    ],
    "usual_activity": "moderate",
    "experience": "beginner",
    "equipment": [
      "bodyweight"
    ],
    "session_duration_minutes": 45,
    "timezone": "America/New_York",
    "preferences": {},
    "expected_revision": 0,
    "operation_key": "{{operationKey}}"
  }
}

script:post-response {
  // Keep the previous value when this request fails.
  if (res.status < 300) {
    const body = res.getBody();
    try { const v = body.revision; if (v !== undefined && v !== null) bru.setVar("profileRevision", v); } catch (e) {}
  }
}

tests {
  test("not a server error", () => expect(res.status).to.be.below(500));
}

docs {
  `PUT /api/v1/training-profile`
  
  Partial bodies allowed; expected_revision is 0 for the first save, then the current revision
}
