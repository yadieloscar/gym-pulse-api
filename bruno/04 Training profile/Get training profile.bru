meta {
  name: Get training profile
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/training-profile
  body: none
  auth: inherit
}

script:post-response {
  // Keep the previous value when this request fails.
  if (res.status < 300) {
    const body = res.getBody();
    try { const v = body.revision; if (v !== undefined && v !== null) bru.setVar("profileRevision", v); } catch (e) {}
  }
}

tests {
  test("not a server error", () => expect(res.status).to.be.below(500));
}

docs {
  `GET /api/v1/training-profile`
  
  404 until a profile is saved
}
