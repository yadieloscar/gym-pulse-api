meta {
  name: Preview goal change
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/plan-transitions/preview
  body: json
  auth: inherit
}

body:json {
  {
    "proposed_profile": {
      "primary_goal": "strength",
      "available_days": [
        1,
        3,
        5
      ],
      "usual_activity": "moderate",
      "experience": "intermediate",
      "equipment": [
        "barbell",
        "dumbbells"
      ],
      "session_duration_minutes": 60,
      "timezone": "America/New_York",
      "preferences": {}
    },
    "from": "2026-11-23",
    "to": "2026-12-06"
  }
}

script:post-response {
  // Keep the previous value when this request fails.
  if (res.status < 300) {
    const body = res.getBody();
    try { const v = body.preview_token; if (v !== undefined && v !== null) bru.setVar("previewToken", v); } catch (e) {}
  }
}

tests {
  test("not a server error", () => expect(res.status).to.be.below(500));
}

docs {
  `POST /api/v1/plan-transitions/preview`
  
  Read-only; 30/min; picks the best starter when no program_id/starter is given
}
