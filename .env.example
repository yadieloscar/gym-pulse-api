# Core
PORT=8080
# Required explicitly when running the binary. The production container also
# defaults this to production as defense in depth.
ENVIRONMENT=development
# Staging/production additionally require sslmode=require, verify-ca, or
# verify-full on all three database URLs. pgx otherwise defaults to
# sslmode=prefer, which silently falls back to plaintext when TLS negotiation
# fails.
#
# Request connection. In staging/production this is the least-privilege
# gym_pulse_api role (migration 026): DML on application tables plus RLS
# policies, no DDL, no ownership, no BYPASSRLS.
DATABASE_URL=postgresql://postgres:password@localhost:5432/gympulse
# Schema-owner connection used only for startup migrations. Required in
# staging/production; development/test default it to DATABASE_URL. Must be a
# direct or session-mode connection because golang-migrate holds a session
# advisory lock while migrating.
DATABASE_MIGRATE_URL=postgresql://postgres:password@localhost:5432/gympulse
# Required in staging/production. Session-level advisory locks must use a
# direct PostgreSQL or Supavisor session-mode connection (normally port 5432),
# never the Supavisor transaction-mode endpoint on port 6543. Development/test
# default this to DATABASE_URL when omitted.
DATABASE_LOCK_URL=postgresql://postgres:password@localhost:5432/gympulse
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1
# Dedicated advisory-lock connections. Keep separate from the main query pool
# so deletion/avatar operations cannot deadlock it under saturation.
DATABASE_LOCK_MAX_CONNS=4
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=1m

# Development/local HMAC fallback. Optional when SUPABASE_JWKS_URL is set and
# not accepted as the sole production configuration.
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Development/test may omit origins. Staging/production require one or more
# explicit HTTPS origins separated by commas.
ALLOWED_ORIGINS=http://localhost:8081
LOG_LEVEL=info

# Required in staging and production. The server derives the issuer and JWKS
# endpoint from SUPABASE_URL. These legacy overrides are optional, but if set
# must match that same project exactly.
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Avatar uploads require these server-only values; staging/production will not
# start without them. Bucket defaults to avatars.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_AVATAR_BUCKET=avatars

# Food logging. The USDA key is free (https://fdc.nal.usda.gov/api-key-signup);
# without it food search answers from the stored catalog only. Open Food Facts
# needs no key but requires an identifying User-Agent.
USDA_FDC_API_KEY=
FOOD_SOURCE_USER_AGENT=GymPulse/1.0 (https://github.com/yadieloscar/gym-pulse-api)
# USDA_FDC_BASE_URL=https://api.nal.usda.gov
# OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
