# Core
PORT=8080
DATABASE_URL=postgresql://postgres:password@localhost:5432/gympulse

# Development/local HMAC fallback. Optional when SUPABASE_JWKS_URL is set and
# not accepted as the sole production configuration.
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Optional
ALLOWED_ORIGINS=http://localhost:8081
ENVIRONMENT=development
LOG_LEVEL=info

# Required in production. The issuer is normally <SUPABASE_URL>/auth/v1 and
# the standard Supabase user-token audience is authenticated.
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
